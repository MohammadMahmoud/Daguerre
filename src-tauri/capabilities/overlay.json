{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Selection overlays: read the frozen frame and report the pick.",
  "windows": ["overlay-*"],
  "permissions": [
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-overlay-frame",
    "allow-overlay-info",
    "allow-finish-selection"
  ]
}
