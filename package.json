{
  "name": "daguerre",
  "private": true,
  "version": "1.0.0",
  "description": "Daguerre: a Chrome extension to capture, annotate and export screenshots. Everything stays on your device.",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:badge": "node scripts/coverage-badge.mjs",
    "release-notes": "node scripts/release-notes.mjs",
    "icons": "node scripts/icons.mjs",
    "package": "pnpm build && pnpm coverage && rm -f daguerre.zip && cd dist && zip -qrX ../daguerre.zip . -x '.*'"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-canvas-mock": "^1.2.0"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "MIT"
}
