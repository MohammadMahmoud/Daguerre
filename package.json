{
  "name": "daguerre",
  "version": "1.0.2",
  "private": true,
  "description": "Daguerre: a Chrome extension and desktop app to capture, annotate and export screenshots. Everything stays on your device.",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && node scripts/PackageExtension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:badge": "node scripts/CoverageBadge.mjs",
    "release-notes": "node scripts/ReleaseNotes.mjs",
    "changelog:update": "node scripts/UpdateChangelog.mjs",
    "publish:release": "node scripts/PublishRelease.mjs",
    "release": "node scripts/PublishRelease.mjs",
    "extension:verify": "node scripts/PackageExtension.mjs --verify",
    "icons": "node scripts/Icons.mjs",
    "package": "pnpm build",
    "desktop:dev": "vite build --mode desktop && tauri dev",
    "desktop:build": "tsc --noEmit && node scripts/DesktopBuild.mjs",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": "prettier --write"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "driver.js": "^1.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-canvas-mock": "^1.2.0"
  },
  "main": "index.js",
  "keywords": [],
  "author": "Mohammed Mahmoud",
  "homepage": "https://mohammadmahmoud.github.io/Daguerre/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MohammadMahmoud/Daguerre"
  },
  "license": "MIT"
}
